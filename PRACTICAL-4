#include <iostream>
#include <chrono>

using namespace std;
using namespace std::chrono;

// Recursive Method
long long factorialRecursive(int n)
{
    if (n == 0 || n == 1)
        return 1;
    else
        return n * factorialRecursive(n - 1);
}

// Iterative Method
long long factorialIterative(int n)
{
    long long fact = 1;

    for (int i = 1; i <= n; i++)
    {
        fact = fact * i;
    }

    return fact;
}

