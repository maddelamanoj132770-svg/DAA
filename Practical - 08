import time

# DFS function
def dfs(graph, vertex, visited):
    if vertex not in visited:
        print(vertex, end=" ")
        visited.add(vertex)

        # Visit all adjacent vertices
        for neighbour in graph[vertex]:
            dfs(graph, neighbour, visited)


